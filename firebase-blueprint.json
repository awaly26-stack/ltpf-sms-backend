{
  "entities": {
    "Student": {
      "title": "Student",
      "description": "Un élève du LTP Fatick",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "firstName": { "type": "string" },
        "name": { "type": "string" },
        "matricule": { "type": "string" },
        "classId": { "type": "string" },
        "isPresent": { "type": "boolean" },
        "unjustifiedAbsences": { "type": "number" },
        "absenceLogs": { "type": "array" },
        "badges": { "type": "array" },
        "incidents": { "type": "array" },
        "emergencyPhone": { "type": "string" },
        "grades": { "type": "array" }
      },
      "required": ["firstName", "name", "matricule", "classId"]
    },
    "SchoolClass": {
      "title": "SchoolClass",
      "description": "Une classe du lycée",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "level": { "type": "string" },
        "field": { "type": "string" },
        "diploma": { "type": "string" }
      },
      "required": ["name", "level", "diploma"]
    },
    "Staff": {
      "title": "Staff",
      "description": "Un membre du personnel (Surveillant, Proviseur, etc.)",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "role": { "type": "string", "enum": ["ADMIN", "PROVISEUR", "DE", "CT", "SG", "SURVEILLANT"] },
        "matricule": { "type": "string" }
      },
      "required": ["name", "role", "matricule"]
    },
    "SchoolEvent": {
      "title": "SchoolEvent",
      "description": "Une annonce ou un événement sur le fil d'actualité",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "date": { "type": "string", "format": "date-time" },
        "type": { "type": "string" },
        "likes": { "type": "number" },
        "comments": { "type": "array" },
        "isUrgent": { "type": "boolean" }
      },
      "required": ["title", "description", "type", "date"]
    },
    "InventoryItem": {
      "title": "InventoryItem",
      "description": "Matériel scolaire, informatique, mobilier et consommables.",
      "type": "object",
      "properties": {
        "ref": { "type": "string" },
        "designation": { "type": "string" },
        "category": { "type": "string", "enum": ["FOURNITURES", "INFORMATIQUE", "MOBILIER", "ENTRETIEN", "SPORT", "CONSOMMABLES", "AUTRES"] },
        "quantity": { "type": "number" },
        "status": { "type": "string", "enum": ["ENTREE", "ATTENTE", "SERVICE", "SORTIE"] },
        "location": { "type": "string" },
        "responsible": { "type": "string" },
        "entryDate": { "type": "string", "format": "date-time" }
      },
      "required": ["ref", "designation", "category", "quantity"]
    },
    "InventoryMovement": {
      "title": "InventoryMovement",
      "description": "Historique des entrées/sorties et changements d'états.",
      "type": "object",
      "properties": {
        "itemId": { "type": "string" },
        "type": { "type": "string", "enum": ["IN", "OUT", "STATUS_CHANGE"] },
        "quantityChange": { "type": "number" },
        "userName": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" }
      }
    },
    "Message": {
      "title": "Message",
      "description": "Message privé entre surveillant et élève",
      "type": "object",
      "properties": {
        "conversationId": { "type": "string" },
        "senderId": { "type": "string" },
        "receiverId": { "type": "string" },
        "text": { "type": "string" },
        "timestamp": { "type": "string" },
        "read": { "type": "boolean" }
      },
      "required": ["conversationId", "senderId", "receiverId", "text"]
    },
    "MediaFile": {
      "title": "MediaFile",
      "description": "Document, audio ou image partagé dans le système",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "url": { "type": "string" },
        "type": { "type": "string", "enum": ["AUDIO", "PDF", "DOC", "XLS", "IMAGE", "AUTRE"] },
        "category": { "type": "string", "enum": ["RAPPORT", "ACTUALITE", "DOCUMENT_PEDAGOGIQUE", "ADMINISTRATION"] },
        "senderId": { "type": "string" },
        "senderName": { "type": "string" },
        "senderRole": { "type": "string" },
        "date": { "type": "string", "format": "date-time" },
        "description": { "type": "string" },
        "adminKey": { "type": "string" }
      },
      "required": ["name", "url", "type", "category", "senderId"]
    },
    "PrivateMail": {
      "title": "PrivateMail",
      "description": "Courrier confidentiel de l'administration vers le personnel",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "senderId": { "type": "string" },
        "senderName": { "type": "string" },
        "senderRole": { "type": "string" },
        "recipientId": { "type": "string" },
        "subject": { "type": "string" },
        "content": { "type": "string" },
        "date": { "type": "string", "format": "date-time" },
        "read": { "type": "boolean" }
      },
      "required": ["senderId", "recipientId", "subject", "content", "date"]
    },
    "ScheduleSlot": {
      "title": "ScheduleSlot",
      "description": "Un créneau dans l'emploi du temps d'une classe",
      "type": "object",
      "properties": {
        "classId": { "type": "string" },
        "subjectId": { "type": "string" },
        "teacherId": { "type": "string" },
        "day": { "type": "string" },
        "startTime": { "type": "string" },
        "endTime": { "type": "string" },
        "room": { "type": "string" }
      }
    }
  },
  "firestore": {
    "students": { "schema": "Student", "description": "Liste des élèves" },
    "classes": { "schema": "SchoolClass", "description": "Liste des classes" },
    "users": { "schema": "Staff", "description": "Personnel administratif et enseignant" },
    "events": { "schema": "SchoolEvent", "description": "Actualités du campus" },
    "inventory": { "schema": "InventoryItem", "description": "Matériel logistique et comptabilité matière" },
    "inventoryMovements": { "schema": "InventoryMovement", "description": "Tracabilité des stocks" },
    "messages": { "schema": "Message", "description": "Messagerie interne" },
    "teachers": { "schema": "object", "description": "Liste des professeurs" },
    "subjects": { "schema": "object", "description": "Matières enseignées" },
    "media": { "schema": "MediaFile", "description": "Médiathèque et Rapports administratifs" },
    "private_mail": { "schema": "PrivateMail", "description": "Courrier confidentiel" },
    "lessonLogs": { "schema": "object", "description": "Cahier de texte - Séances de cours" },
    "resources": { "schema": "object", "description": "Hub Ressources pédagogiques" },
    "exams": { "schema": "object", "description": "Planning des examens et contrôles" },
    "conseils": { "schema": "object", "description": "Discussions privées entre surveillants et élèves" },
    "schedules": { "schema": "ScheduleSlot", "description": "Emplois du temps hebdomadaires" },
    "councils": { "schema": "object", "description": "Compte-rendus des conseils de classe" },
    "progression": { "schema": "object", "description": "Suivi de l'avancement des programmes" },
    "meetings": { "schema": "object", "description": "Sessions de visio-conférence en ligne" },
    "reports": { "schema": "object", "description": "Rapports et demandes transmis à la Direction" }
  }
}

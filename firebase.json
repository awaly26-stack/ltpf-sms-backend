{
  "hosting": {
    "public": "dist",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/api/**",
        "destination": "https://erupt-cornflake-jot.ngrok-free.dev/api/orange/sms"
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  }
}